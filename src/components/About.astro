---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about-section relative py-28 md:py-36 px-6 md:px-12 max-w-[1440px] mx-auto border-b border-olive-700">
  
  <!-- Top Architectural Section Bar -->
  <div class="flex items-center justify-between border-b border-olive-700 pb-4 mb-16 font-mono text-xs uppercase tracking-[0.2em] text-moss-500 scroll-reveal reveal-up">
    <div class="flex items-center gap-3">
      <span class="text-accent-400 font-bold">00 //</span>
      <span class="text-cream-100">{t('about.label')}</span>
    </div>
    <span>PROFILE_SPEC · REV_2026</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative z-10">
    
    <!-- Left: Sharp Editorial Portrait Frame with Corner Reticles & 3D Tilt -->
    <div class="lg:col-span-5 relative group scroll-reveal reveal-left">
      
      <!-- Offset Structural Frame Behind Portrait -->
      <div class="absolute -bottom-3 -right-3 w-full h-full border border-accent-400/50 pointer-events-none transition-transform duration-500 group-hover:translate-x-1.5 group-hover:translate-y-1.5"></div>

      <!-- Main Portrait Container (0px sharp brutalist corners) -->
      <div 
        id="about-photo-card" 
        class="corner-brackets relative w-full h-[500px] sm:h-[580px] lg:h-[640px] bg-forest-900 border border-olive-700 overflow-hidden will-change-transform"
      >
        <!-- Top Technical Overlay Strip -->
        <div class="absolute top-0 inset-x-0 z-20 flex justify-between items-center px-4 py-2.5 bg-forest-950/80 border-b border-olive-700 font-mono text-[10px] tracking-[0.2em] text-moss-500 uppercase">
          <span>SUBJ // S.ESCOBAR</span>
          <span class="text-accent-400">REC ●</span>
        </div>

        <!-- Portrait Image -->
        <img 
          id="about-portrait-img" 
          src="/Portfolio/images/SebasFoto.png" 
          alt={t('about.photoAlt')} 
          class="w-full h-full object-cover object-top filter grayscale contrast-125 brightness-95 group-hover:grayscale-0 transition-all duration-700 ease-out pointer-events-none"
          loading="eager"
        />

        <!-- Bottom Vignette -->
        <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/15 to-transparent pointer-events-none"></div>

        <!-- Specular reflection sheen following mouse -->
        <div class="photo-sheen absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none bg-[radial-gradient(circle_at_var(--sheen-x,50%)_var(--sheen-y,50%),rgba(255,85,0,0.14),transparent_60%)]"></div>

        <!-- Bottom Technical Status Readout Bar (Sharp Flush Bar, NOT a pill) -->
        <div class="absolute bottom-0 inset-x-0 z-20 p-4 bg-forest-950/95 border-t border-olive-700 flex items-center justify-between gap-3 pointer-events-none font-mono text-xs">
          <div class="flex items-center gap-2.5">
            <span class="inline-block w-2 h-2 bg-accent-400"></span>
            <span class="text-cream-100 uppercase tracking-wider font-semibold text-[11px]">
              {lang === 'es' ? 'DISPONIBLE PARA PROYECTOS' : 'AVAILABLE FOR PROJECTS'}
            </span>
          </div>
          <span class="text-[10px] text-moss-500 uppercase tracking-widest">
            MDE // COL
          </span>
        </div>
      </div>
    </div>

    <!-- Right: Editorial Manifesto & Architectural Telemetry Table -->
    <div class="lg:col-span-7 flex flex-col justify-between scroll-reveal reveal-right" data-delay="120">
      
      <div>
        <!-- Massive High-Contrast Display Statement -->
        <h3 class="font-display text-4xl sm:text-6xl lg:text-[4.25rem] text-cream-100 font-extrabold uppercase tracking-tighter mb-10 leading-[0.95]">
          {t('about.title')}
        </h3>

        <!-- Editorial Columns / Bio Copy -->
        <div class="space-y-6 text-cream-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
          <p class="border-l-2 border-accent-400 pl-6 text-cream-100 font-medium text-lg sm:text-xl leading-snug">
            {t('about.p1')}
          </p>
          <p class="pl-6 text-cream-300">
            {t('about.p2')}
          </p>
          <p class="pl-6 text-moss-500 text-sm sm:text-base font-mono">
            // {t('about.p3')}
          </p>
        </div>
      </div>

      <!-- Exposed Hairline Spec Sheet Grid -->
      <div class="mt-14 border border-olive-700 bg-olive-700 grid grid-cols-1 sm:grid-cols-3 gap-px overflow-hidden">
        <div class="p-5 bg-forest-900/90 hover:bg-forest-900 transition-colors">
          <div class="font-mono text-moss-500 text-[10px] uppercase tracking-[0.2em] mb-2 flex justify-between">
            <span>{lang === 'es' ? 'ESPECIALIDAD' : 'DISCIPLINE'}</span>
            <span class="text-accent-400">[01]</span>
          </div>
          <div class="font-display text-cream-100 font-bold uppercase tracking-tight text-lg">
            Game &amp; XR Dev
          </div>
        </div>

        <div class="p-5 bg-forest-900/90 hover:bg-forest-900 transition-colors">
          <div class="font-mono text-moss-500 text-[10px] uppercase tracking-[0.2em] mb-2 flex justify-between">
            <span>{lang === 'es' ? 'MOTORES' : 'CORE ENGINES'}</span>
            <span class="text-accent-400">[02]</span>
          </div>
          <div class="font-display text-cream-100 font-bold uppercase tracking-tight text-lg">
            Unity · Unreal 5
          </div>
        </div>

        <div class="p-5 bg-forest-900/90 hover:bg-forest-900 transition-colors">
          <div class="font-mono text-moss-500 text-[10px] uppercase tracking-[0.2em] mb-2 flex justify-between">
            <span>{lang === 'es' ? 'PLATAFORMAS' : 'PLATFORMS'}</span>
            <span class="text-accent-400">[03]</span>
          </div>
          <div class="font-display text-cream-100 font-bold uppercase tracking-tight text-lg">
            PC · VR · AR · Mobile
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initAboutInteractions() {
    const photoCard = document.getElementById('about-photo-card');
    if (!photoCard) return;

    let targetTiltX = 0;
    let targetTiltY = 0;
    let currentTiltX = 0;
    let currentTiltY = 0;

    photoCard.addEventListener('mousemove', (e) => {
      const rect = photoCard.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      targetTiltX = ((y - centerY) / centerY) * -4.5;
      targetTiltY = ((x - centerX) / centerX) * 4.5;

      photoCard.style.setProperty('--sheen-x', `${(x / rect.width) * 100}%`);
      photoCard.style.setProperty('--sheen-y', `${(y / rect.height) * 100}%`);
    });

    photoCard.addEventListener('mouseleave', () => {
      targetTiltX = 0;
      targetTiltY = 0;
    });

    let animId: number;
    function renderLoop() {
      currentTiltX += (targetTiltX - currentTiltX) * 0.1;
      currentTiltY += (targetTiltY - currentTiltY) * 0.1;
      photoCard!.style.transform = `perspective(1000px) rotateX(${currentTiltX}deg) rotateY(${currentTiltY}deg)`;

      animId = requestAnimationFrame(renderLoop);
    }
    renderLoop();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initAboutInteractions);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAboutInteractions();
  } else {
    document.addEventListener('DOMContentLoaded', initAboutInteractions);
  }
</script>
