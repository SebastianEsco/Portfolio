---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about-section relative py-32 px-6 md:px-12 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center relative z-10">
    
    <!-- Left: Photo Showcase with Smooth 3D Perspective Tilt & Specular Sheen (No cut-off) -->
    <div class="lg:col-span-5 relative group scroll-reveal reveal-left">
      <!-- Soft ambient backdrop glow -->
      <div class="absolute -inset-2 bg-gradient-to-r from-accent-400/20 via-olive-700/20 to-moss-500/20 rounded-3xl blur-xl opacity-40 group-hover:opacity-75 transition duration-700 pointer-events-none"></div>

      <!-- Main photo card with 3D tilt -->
      <div 
        id="about-photo-card" 
        class="relative w-full h-[520px] sm:h-[600px] lg:h-[660px] rounded-3xl overflow-hidden bg-forest-900 border border-olive-700/80 shadow-2xl will-change-transform"
      >
        <!-- Portrait image cleanly framed with object-top (his head and body are never cut off) -->
        <img 
          id="about-portrait-img" 
          src="/Portfolio/images/SebasFoto.png" 
          alt={t('about.photoAlt')} 
          class="w-full h-full object-cover object-top filter grayscale contrast-125 brightness-95 opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 ease-out pointer-events-none"
          loading="eager"
        />

        <!-- Multi-stop cinematic dark gradient overlays for seamless integration -->
        <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/20 to-transparent pointer-events-none"></div>
        <div class="absolute inset-0 bg-forest-950/15 mix-blend-multiply pointer-events-none"></div>

        <!-- Specular reflection sheen following mouse -->
        <div class="photo-sheen absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none bg-[radial-gradient(circle_at_var(--sheen-x,50%)_var(--sheen-y,50%),rgba(255,255,255,0.12),transparent_60%)]"></div>

        <!-- Floating live status badge -->
        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-forest-950/90 backdrop-blur-md border border-olive-700/60 shadow-xl flex items-center justify-between gap-3 pointer-events-none">
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-400"></span>
            </span>
            <span class="font-mono text-xs text-cream-100 font-medium tracking-wide">
              {lang === 'es' ? 'Disponible para proyectos' : 'Available for projects'}
            </span>
          </div>
          <span class="font-mono text-[11px] text-moss-500 tracking-wider">
            Medellín, CO
          </span>
        </div>
      </div>
    </div>

    <!-- Right: Editorial Typography & Micro-Stats -->
    <div class="lg:col-span-7 flex flex-col justify-center scroll-reveal reveal-right" data-delay="150">
      <!-- Section Tag -->
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-accent-400 text-xs tracking-widest uppercase bg-accent-400/10 px-3 py-1 rounded-md border border-accent-400/20">
          {t('about.label')}
        </span>
        <div class="h-px flex-1 bg-gradient-to-r from-olive-700/60 to-transparent"></div>
      </div>

      <!-- Big expressive title -->
      <h3 class="font-display text-4xl sm:text-5xl lg:text-6xl text-cream-100 font-semibold tracking-tight mb-8 leading-[1.12]">
        {t('about.title')}
      </h3>

      <!-- Rich Bio Text -->
      <div class="space-y-6 text-cream-300 font-sans text-lg sm:text-xl font-light leading-relaxed">
        <p class="border-l-2 border-accent-400/60 pl-5 text-cream-100 font-normal">
          {t('about.p1')}
        </p>
        <p class="pl-5 text-cream-300/90 text-base sm:text-lg">
          {t('about.p2')}
        </p>
        <p class="pl-5 text-cream-300/80 text-base sm:text-lg">
          {t('about.p3')}
        </p>
      </div>

      <!-- Highlight Strip -->
      <div class="mt-12 pt-8 border-t border-olive-700/40 grid grid-cols-2 sm:grid-cols-3 gap-6">
        <div class="p-4 rounded-xl bg-forest-900/40 border border-olive-700/40 hover:border-accent-400/50 transition-colors">
          <div class="font-mono text-accent-400 text-xs uppercase tracking-wider mb-1">
            {lang === 'es' ? 'Especialidad' : 'Specialty'}
          </div>
          <div class="font-display text-cream-100 font-medium text-base sm:text-lg">
            Game & XR Dev
          </div>
        </div>

        <div class="p-4 rounded-xl bg-forest-900/40 border border-olive-700/40 hover:border-accent-400/50 transition-colors">
          <div class="font-mono text-accent-400 text-xs uppercase tracking-wider mb-1">
            {lang === 'es' ? 'Motores' : 'Engines'}
          </div>
          <div class="font-display text-cream-100 font-medium text-base sm:text-lg">
            Unity & Unreal 5
          </div>
        </div>

        <div class="col-span-2 sm:col-span-1 p-4 rounded-xl bg-forest-900/40 border border-olive-700/40 hover:border-accent-400/50 transition-colors">
          <div class="font-mono text-accent-400 text-xs uppercase tracking-wider mb-1">
            {lang === 'es' ? 'Enfoque' : 'Focus'}
          </div>
          <div class="font-display text-cream-100 font-medium text-base sm:text-lg">
            PC · VR · AR · Mobile
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initAboutInteractions() {
    const photoCard = document.getElementById('about-photo-card');
    if (!photoCard) return;

    let targetTiltX = 0;
    let targetTiltY = 0;
    let currentTiltX = 0;
    let currentTiltY = 0;

    // Smooth 3D perspective tilt tracking on photo card
    photoCard.addEventListener('mousemove', (e) => {
      const rect = photoCard.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      targetTiltX = ((y - centerY) / centerY) * -6; // max 6 deg tilt
      targetTiltY = ((x - centerX) / centerX) * 6;  // max 6 deg tilt

      photoCard.style.setProperty('--sheen-x', `${(x / rect.width) * 100}%`);
      photoCard.style.setProperty('--sheen-y', `${(y / rect.height) * 100}%`);
    });

    photoCard.addEventListener('mouseleave', () => {
      targetTiltX = 0;
      targetTiltY = 0;
    });

    // Continuous RAF lerp loop for physically damped smooth tilt
    let animId: number;
    function renderLoop() {
      currentTiltX += (targetTiltX - currentTiltX) * 0.1;
      currentTiltY += (targetTiltY - currentTiltY) * 0.1;
      photoCard!.style.transform = `perspective(1000px) rotateX(${currentTiltX}deg) rotateY(${currentTiltY}deg)`;

      animId = requestAnimationFrame(renderLoop);
    }
    renderLoop();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initAboutInteractions);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAboutInteractions();
  } else {
    document.addEventListener('DOMContentLoaded', initAboutInteractions);
  }
</script>
