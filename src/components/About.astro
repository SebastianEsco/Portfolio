---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about-section relative py-32 px-6 md:px-12 max-w-7xl mx-auto overflow-hidden">
  <!-- Dynamic ambient moving gradient orbs behind the section -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-accent-400/10 rounded-full blur-3xl pointer-events-none ambient-orb-1"></div>
  <div class="absolute -bottom-24 -right-24 w-[30rem] h-[30rem] bg-moss-500/15 rounded-full blur-3xl pointer-events-none ambient-orb-2"></div>
  <div class="mouse-glow absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-700 bg-[radial-gradient(600px_circle_at_var(--mouse-x,50%)_var(--mouse-y,50%),rgba(251,146,60,0.06),transparent_80%)]"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center relative z-10">
    
    <!-- Left: Parallax Photo Showcase with 3D Tilt & Floating Badges -->
    <div class="lg:col-span-5 relative group">
      <!-- Glow outline on hover -->
      <div class="absolute -inset-1 bg-gradient-to-r from-accent-400/30 to-moss-500/30 rounded-3xl blur-md opacity-40 group-hover:opacity-80 transition duration-700 pointer-events-none"></div>

      <!-- Main photo viewport -->
      <div 
        id="about-photo-card" 
        class="relative w-full h-[520px] sm:h-[600px] lg:h-[660px] rounded-3xl overflow-hidden bg-forest-900 border border-olive-700/80 shadow-2xl transition-transform duration-300 ease-out"
      >
        <!-- Parallax image: taller than container so scroll moves it seamlessly -->
        <img 
          id="about-parallax-img" 
          src="/Portfolio/images/SebasFoto.png" 
          alt={t('about.photoAlt')} 
          class="absolute -top-[12%] left-0 w-full h-[125%] object-cover object-top filter grayscale contrast-125 brightness-95 opacity-85 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 ease-out will-change-transform"
          loading="eager"
        />

        <!-- Multi-stop cinematic dark gradient overlays -->
        <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/30 to-transparent pointer-events-none"></div>
        <div class="absolute inset-0 bg-forest-950/20 mix-blend-multiply pointer-events-none"></div>

        <!-- Specular sheen reflection on mouse move -->
        <div class="photo-sheen absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none bg-[radial-gradient(circle_at_var(--sheen-x,50%)_var(--sheen-y,50%),rgba(255,255,255,0.15),transparent_60%)]"></div>

        <!-- Floating status badge bottom-left -->
        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-forest-950/85 backdrop-blur-md border border-olive-700/60 shadow-xl flex items-center justify-between gap-3 transform translate-y-1 group-hover:translate-y-0 transition-transform duration-500">
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-400"></span>
            </span>
            <span class="font-mono text-xs text-cream-100 font-medium tracking-wide">
              {lang === 'es' ? 'Disponible para proyectos' : 'Available for projects'}
            </span>
          </div>
          <span class="font-mono text-[11px] text-moss-500 tracking-wider">
            Medellín, CO
          </span>
        </div>
      </div>
    </div>

    <!-- Right: Editorial Typography & Micro-Stats -->
    <div class="lg:col-span-7 flex flex-col justify-center">
      <!-- Section Tag -->
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-accent-400 text-xs tracking-widest uppercase bg-accent-400/10 px-3 py-1 rounded-md border border-accent-400/20">
          {t('about.label')}
        </span>
        <div class="h-px flex-1 bg-gradient-to-r from-olive-700/60 to-transparent"></div>
      </div>

      <!-- Big expressive title -->
      <h3 class="font-display text-4xl sm:text-5xl lg:text-6xl text-cream-100 font-semibold tracking-tight mb-8 leading-[1.12]">
        {t('about.title')}
      </h3>

      <!-- Rich Bio Text -->
      <div class="space-y-6 text-cream-300 font-sans text-lg sm:text-xl font-light leading-relaxed">
        <p class="border-l-2 border-accent-400/60 pl-5 text-cream-100 font-normal">
          {t('about.p1')}
        </p>
        <p class="pl-5 text-cream-300/90 text-base sm:text-lg">
          {t('about.p2')}
        </p>
        <p class="pl-5 text-cream-300/80 text-base sm:text-lg">
          {t('about.p3')}
        </p>
      </div>

      <!-- Interactive Highlight Strip -->
      <div class="mt-12 pt-8 border-t border-olive-700/40 grid grid-cols-2 sm:grid-cols-3 gap-6">
        <div class="p-4 rounded-xl bg-forest-900/40 border border-olive-700/40 hover:border-accent-400/50 transition-colors">
          <div class="font-mono text-accent-400 text-xs uppercase tracking-wider mb-1">
            {lang === 'es' ? 'Especialidad' : 'Specialty'}
          </div>
          <div class="font-display text-cream-100 font-medium text-base sm:text-lg">
            Game & XR Dev
          </div>
        </div>

        <div class="p-4 rounded-xl bg-forest-900/40 border border-olive-700/40 hover:border-accent-400/50 transition-colors">
          <div class="font-mono text-accent-400 text-xs uppercase tracking-wider mb-1">
            {lang === 'es' ? 'Motores' : 'Engines'}
          </div>
          <div class="font-display text-cream-100 font-medium text-base sm:text-lg">
            Unity & Unreal 5
          </div>
        </div>

        <div class="col-span-2 sm:col-span-1 p-4 rounded-xl bg-forest-900/40 border border-olive-700/40 hover:border-accent-400/50 transition-colors">
          <div class="font-mono text-accent-400 text-xs uppercase tracking-wider mb-1">
            {lang === 'es' ? 'Enfoque' : 'Focus'}
          </div>
          <div class="font-display text-cream-100 font-medium text-base sm:text-lg">
            PC · VR · AR · Mobile
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes orbDrift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -20px) scale(1.08); }
  }
  .ambient-orb-1 {
    animation: orbDrift 16s ease-in-out infinite;
  }
  .ambient-orb-2 {
    animation: orbDrift 20s ease-in-out infinite reverse;
  }
</style>

<script>
  function initAboutInteractions() {
    const section = document.querySelector<HTMLElement>('.about-section');
    const photoCard = document.getElementById('about-photo-card');
    const parallaxImg = document.getElementById('about-parallax-img');
    const mouseGlow = document.querySelector<HTMLElement>('.mouse-glow');

    if (!section || !photoCard || !parallaxImg) return;

    // 1. Scroll-driven vertical Parallax
    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const rect = section!.getBoundingClientRect();
          const windowHeight = window.innerHeight;

          // Check if section is around viewport
          if (rect.top < windowHeight && rect.bottom > 0) {
            // Normalized progress from 0 (entering view) to 1 (leaving view)
            const progress = (windowHeight - rect.top) / (windowHeight + rect.height);
            // Parallax offset: shift photo between -40px and +40px
            const offset = (progress - 0.5) * 80;
            parallaxImg!.style.transform = `translateY(${offset}px)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 2. Cursor dynamic spotlight & 3D tilt
    section.addEventListener('mousemove', (e) => {
      const rect = section.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      section.style.setProperty('--mouse-x', `${x}px`);
      section.style.setProperty('--mouse-y', `${y}px`);
      if (mouseGlow) mouseGlow.style.opacity = '1';
    });

    section.addEventListener('mouseleave', () => {
      if (mouseGlow) mouseGlow.style.opacity = '0';
    });

    // 3. 3D tilt & sheen on the photo card
    photoCard.addEventListener('mousemove', (e) => {
      const rect = photoCard.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -6; // Max 6 deg
      const rotateY = ((x - centerX) / centerX) * 6;  // Max 6 deg

      photoCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      photoCard.style.setProperty('--sheen-x', `${(x / rect.width) * 100}%`);
      photoCard.style.setProperty('--sheen-y', `${(y / rect.height) * 100}%`);
    });

    photoCard.addEventListener('mouseleave', () => {
      photoCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
    });
  }

  document.addEventListener('astro:page-load', initAboutInteractions);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAboutInteractions();
  } else {
    document.addEventListener('DOMContentLoaded', initAboutInteractions);
  }
</script>
