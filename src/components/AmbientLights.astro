---
---

<div id="ambient-lighting-layer" class="fixed inset-0 pointer-events-none z-20 overflow-hidden" aria-hidden="true">
  <!-- Primary Lerped Cursor Spotlight (Subtle, soft Terracotta glow) -->
  <div 
    id="cursor-spotlight" 
    class="absolute w-[750px] h-[750px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none opacity-0 transition-opacity duration-500 blur-3xl will-change-transform bg-[radial-gradient(circle,rgba(251,146,60,0.10)_0%,rgba(251,146,60,0.03)_45%,transparent_70%)]"
  ></div>

  <!-- Ambient Orb 1: Warm Subtle Terracotta -->
  <div 
    id="ambient-orb-1" 
    class="ambient-orb absolute w-[520px] h-[520px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none blur-[100px] opacity-40 will-change-transform bg-[radial-gradient(circle,rgba(251,146,60,0.14)_0%,rgba(251,146,60,0.04)_50%,transparent_70%)]"
  ></div>

  <!-- Ambient Orb 2: Gentle Moss Tone -->
  <div 
    id="ambient-orb-2" 
    class="ambient-orb absolute w-[600px] h-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none blur-[120px] opacity-35 will-change-transform bg-[radial-gradient(circle,rgba(163,230,53,0.08)_0%,rgba(122,134,89,0.12)_45%,transparent_70%)]"
  ></div>

  <!-- Ambient Orb 3: Soft Amber / Cream Tone -->
  <div 
    id="ambient-orb-3" 
    class="ambient-orb absolute w-[460px] h-[460px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none blur-[90px] opacity-30 will-change-transform bg-[radial-gradient(circle,rgba(245,158,11,0.10)_0%,rgba(241,235,219,0.035)_50%,transparent_70%)]"
  ></div>
</div>

<script>
  function setupAmbientLighting() {
    const spotlight = document.getElementById('cursor-spotlight');
    const orb1El = document.getElementById('ambient-orb-1');
    const orb2El = document.getElementById('ambient-orb-2');
    const orb3El = document.getElementById('ambient-orb-3');

    if (!spotlight || !orb1El || !orb2El || !orb3El) return;

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let currentX = targetX;
    let currentY = targetY;
    let mouseActive = false;

    // Subtly drifting orbs with smooth mouse interaction
    const orbs = [
      {
        el: orb1El,
        baseXRatio: 0.22,
        baseYRatio: 0.3,
        curX: window.innerWidth * 0.22,
        curY: window.innerHeight * 0.3,
        driftRadiusX: 75,
        driftRadiusY: 55,
        speed: 0.0008,
        phase: 0,
        reaction: -0.12
      },
      {
        el: orb2El,
        baseXRatio: 0.78,
        baseYRatio: 0.58,
        curX: window.innerWidth * 0.78,
        curY: window.innerHeight * 0.58,
        driftRadiusX: 90,
        driftRadiusY: 65,
        speed: 0.0006,
        phase: Math.PI / 1.8,
        reaction: -0.10
      },
      {
        el: orb3El,
        baseXRatio: 0.5,
        baseYRatio: 0.82,
        curX: window.innerWidth * 0.5,
        curY: window.innerHeight * 0.82,
        driftRadiusX: 65,
        driftRadiusY: 50,
        speed: 0.0009,
        phase: Math.PI,
        reaction: 0.08
      }
    ];

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;
      if (!mouseActive) {
        mouseActive = true;
        spotlight!.style.opacity = '1';
      }
    }

    function onMouseLeave() {
      mouseActive = false;
      spotlight!.style.opacity = '0';
    }

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    document.documentElement.addEventListener('mouseleave', onMouseLeave);

    let animId: number;
    let startTime = performance.now();

    function update() {
      const time = performance.now() - startTime;

      // Smooth lerp for primary cursor spotlight
      currentX += (targetX - currentX) * 0.075;
      currentY += (targetY - currentY) * 0.075;
      spotlight!.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;

      // Update ambient orbs
      const winW = window.innerWidth;
      const winH = window.innerHeight;

      orbs.forEach((orb) => {
        const baseX = winW * orb.baseXRatio;
        const baseY = winH * orb.baseYRatio;
        const driftX = Math.sin(time * orb.speed + orb.phase) * orb.driftRadiusX;
        const driftY = Math.cos(time * orb.speed * 0.9 + orb.phase) * orb.driftRadiusY;

        let interactX = 0;
        let interactY = 0;
        if (mouseActive) {
          const distX = targetX - (baseX + driftX);
          const distY = targetY - (baseY + driftY);
          const dist = Math.hypot(distX, distY);
          const maxInfluence = 500;

          if (dist < maxInfluence) {
            const factor = Math.pow(1 - dist / maxInfluence, 1.4);
            interactX = distX * factor * orb.reaction;
            interactY = distY * factor * orb.reaction;
          }
        }

        const destX = baseX + driftX + interactX;
        const destY = baseY + driftY + interactY;

        orb.curX += (destX - orb.curX) * 0.05;
        orb.curY += (destY - orb.curY) * 0.05;

        orb.el.style.transform = `translate3d(${orb.curX}px, ${orb.curY}px, 0)`;
      });

      animId = requestAnimationFrame(update);
    }

    update();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('mousemove', onMouseMove);
      document.documentElement.removeEventListener('mouseleave', onMouseLeave);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', setupAmbientLighting);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupAmbientLighting();
  } else {
    document.addEventListener('DOMContentLoaded', setupAmbientLighting);
  }
</script>
