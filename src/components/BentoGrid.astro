---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { projectUrl } from '../i18n/paths';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get projects for current language
const allProjects = await getCollection('projects', ({ id }) => {
  return id.startsWith(`${lang}/`);
});

// Explicitly place Echoes first so it occupies the primary large bento card (col-span-8, row-span-2)
const projects = allProjects.sort((a, b) => {
  const isEchoesA = a.id.includes('echoes');
  const isEchoesB = b.id.includes('echoes');
  if (isEchoesA && !isEchoesB) return -1;
  if (!isEchoesA && isEchoesB) return 1;
  return b.data.year - a.data.year;
}).slice(0, 4);
---

<section id="work" class="py-24 px-6 md:px-12 max-w-7xl mx-auto">
  <div class="flex items-baseline justify-between mb-12">
    <div>
      <h2 class="font-mono text-moss-500 uppercase tracking-widest text-xs md:text-sm mb-3">{t('work.label')}</h2>
      <h3 class="font-display text-4xl md:text-5xl text-cream-100 font-semibold tracking-tight">{t('work.title')}</h3>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 lg:gap-8 auto-rows-[340px] md:auto-rows-[380px] lg:auto-rows-[320px]">
    {projects.map((project, index) => {
      let cardClasses = "bento-card group relative rounded-2xl overflow-hidden bg-forest-900 border border-olive-700/60 block transition-all duration-500 hover:border-accent-400/60 hover:shadow-2xl hover:shadow-black/60";
      
      if (index === 0) {
        // Echoes: Massive primary feature card spanning 8 columns and 2 rows
        cardClasses += " lg:col-span-8 lg:row-span-2 min-h-[460px] lg:min-h-full";
      } else if (index === 1 || index === 2) {
        // Secondary cards stacked on the right
        cardClasses += " lg:col-span-4 lg:row-span-1 min-h-[300px]";
      } else {
        // Fourth project: Panoramic card spanning the full width below
        cardClasses += " md:col-span-2 lg:col-span-12 lg:row-span-1 min-h-[280px]";
      }

      const slug = project.id.replace(`${lang}/`, '').replace('.md', '');

      return (
        <a href={projectUrl(lang, slug)} class={cardClasses} data-slug={slug}>
          {/* Visual media container */}
          <div class="absolute inset-0 z-0 overflow-hidden">
            <img 
              src={project.data.coverImage} 
              alt={project.data.title}
              class="w-full h-full object-cover object-center opacity-70 group-hover:opacity-40 group-hover:scale-105 transition-all duration-700 ease-out"
              loading={index === 0 ? "eager" : "lazy"}
            />
            {project.data.previewVideo && (
              <video 
                src={project.data.previewVideo}
                muted 
                loop 
                playsinline
                preload="metadata"
                class="bento-video absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
              />
            )}
            {/* Multi-stop gradient for readable text and studio feel */}
            <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/50 to-transparent pointer-events-none"></div>
            <div class="absolute inset-0 bg-forest-950/20 mix-blend-multiply pointer-events-none"></div>
          </div>
          
          {/* Card Meta & Content */}
          <div class="absolute inset-0 z-10 p-6 md:p-8 flex flex-col justify-between">
            {/* Top row: tags and badge */}
            <div class="flex items-center justify-between gap-3 flex-wrap">
              <div class="flex items-center gap-2 flex-wrap">
                {project.data.award && (
                  <span class="px-2.5 py-1 bg-rust-500/90 text-cream-100 text-[10px] uppercase tracking-widest font-mono rounded-md shadow-sm backdrop-blur-sm border border-rust-500">
                    ★ {project.data.award}
                  </span>
                )}
                <span class="font-mono text-moss-500 uppercase tracking-widest text-xs bg-forest-950/60 px-2.5 py-1 rounded-md border border-olive-700/40 backdrop-blur-sm">
                  {project.data.year}
                </span>
                <span class="font-mono text-moss-500 uppercase tracking-widest text-xs bg-forest-950/60 px-2.5 py-1 rounded-md border border-olive-700/40 backdrop-blur-sm">
                  {project.data.platform}
                </span>
              </div>

              {/* Engine tag */}
              <span class="font-mono text-cream-300/70 text-xs tracking-wider hidden sm:inline-block">
                {project.data.engine}
              </span>
            </div>
            
            {/* Bottom row: title and CTA */}
            <div>
              <h4 class={`font-display text-cream-100 font-medium tracking-tight mb-2 group-hover:text-accent-400 transition-colors ${
                index === 0 ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl'
              }`}>
                {project.data.title}
              </h4>
              
              <div class="flex items-center text-cream-300 font-sans text-sm font-medium pt-2 group-hover:translate-x-1 transition-transform duration-300">
                <span class="text-accent-400 group-hover:underline underline-offset-4 mr-2">{t('work.view')}</span>
                <svg class="w-4 h-4 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>

<script>
  // Enhanced hover & viewport video playback for Bento cards
  function initBentoVideos() {
    const cards = document.querySelectorAll<HTMLElement>('.bento-card');

    cards.forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('.bento-video');
      if (!video) return;

      // Desktop hover
      card.addEventListener('mouseenter', () => {
        video.play().catch(() => {});
      });

      card.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    });

    // Mobile / IntersectionObserver: play video gently when card is centered in view on touch devices
    if ('IntersectionObserver' in window && window.matchMedia('(hover: none)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target.querySelector<HTMLVideoElement>('.bento-video');
            if (!video) return;
            if (entry.isIntersecting) {
              video.play().catch(() => {});
              video.style.opacity = '1';
            } else {
              video.pause();
              video.style.opacity = '0';
            }
          });
        },
        { threshold: 0.6 }
      );

      cards.forEach((card) => observer.observe(card));
    }
  }

  document.addEventListener('astro:page-load', initBentoVideos);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initBentoVideos();
  } else {
    document.addEventListener('DOMContentLoaded', initBentoVideos);
  }
</script>
