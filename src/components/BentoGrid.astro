---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { projectUrl } from '../i18n/paths';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get projects for current language
const allProjects = await getCollection('projects', ({ id }) => {
  return id.startsWith(`${lang}/`);
});

// Sort by year
const projects = allProjects.sort((a, b) => b.data.year - a.data.year).slice(0, 4);
---

<section id="work" class="py-24 px-6 md:px-12 max-w-7xl mx-auto">
  <div class="flex items-baseline justify-between mb-12">
    <div>
      <h2 class="font-mono text-moss-500 uppercase tracking-widest text-sm mb-4">{t('work.label')}</h2>
      <h3 class="font-display text-4xl md:text-5xl text-cream-100">{t('work.title')}</h3>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 lg:gap-8 auto-rows-[400px]">
    {projects.map((project, index) => {
      // Bento layout classes based on index
      // 0: big left (lg:col-span-8 lg:row-span-2)
      // 1: top right (lg:col-span-4 lg:row-span-1)
      // 2: bottom right (lg:col-span-4 lg:row-span-1)
      // 3: full width if available, or just standard box
      
      let classes = "group relative rounded-xl overflow-hidden bg-forest-900 border border-olive-700/50 block";
      
      if (index === 0) {
        classes += " lg:col-span-8 lg:row-span-2 h-full";
      } else if (index === 1 || index === 2) {
        classes += " lg:col-span-4 lg:row-span-1 h-full";
      } else {
        classes += " lg:col-span-12 lg:row-span-1 h-[300px]";
      }

      // We extract slug by removing language prefix
      const slug = project.id.replace(`${lang}/`, '').replace('.md', '');

      return (
        <a href={projectUrl(lang, slug)} class={classes}>
          {/* Cover Image */}
          <div class="absolute inset-0 z-0">
            <img 
              src={project.data.coverImage} 
              alt={project.data.title}
              class="w-full h-full object-cover opacity-60 group-hover:opacity-40 transition-opacity duration-700"
            />
            {project.data.previewVideo && (
               <video 
                src={project.data.previewVideo}
                muted loop playsinline
                class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-700"
               />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/20 to-transparent"></div>
          </div>
          
          {/* Content */}
          <div class="absolute inset-0 z-10 p-8 flex flex-col justify-end">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              {project.data.award && (
                <span class="px-2 py-1 bg-rust-500 text-cream-100 text-[10px] uppercase tracking-widest font-mono rounded-sm">
                  {project.data.award}
                </span>
              )}
              <span class="font-mono text-moss-500 uppercase tracking-widest text-xs">
                {project.data.year}
              </span>
              <span class="w-1 h-1 rounded-full bg-olive-700"></span>
              <span class="font-mono text-moss-500 uppercase tracking-widest text-xs">
                {project.data.platform}
              </span>
            </div>
            
            <h4 class="font-display text-3xl text-cream-100 mb-2 group-hover:text-brass-400 transition-colors">
              {project.data.title}
            </h4>
            
            <div class="flex items-center text-cream-300 font-sans text-sm translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
              {t('work.view')} 
              <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>
