---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 px-6 md:px-12 max-w-3xl mx-auto border-t border-olive-700/30 text-center">
  <div class="mb-8">
    <h2 class="font-mono text-moss-500 uppercase tracking-widest text-sm mb-2">{t('education.label')}</h2>
  </div>
  
  <div class="bg-forest-900 border border-olive-700 p-8 rounded-xl inline-block text-left">
    <div class="font-display text-2xl text-cream-100 mb-1">
      {lang === 'es' ? 'Ingeniería / Desarrollo de Videojuegos' : 'Game Development / Engineering'}
    </div>
    <div class="font-sans text-accent-400 font-medium mb-3">
      {lang === 'es' ? 'Estudiante de último semestre (Próximo a graduarse)' : 'Final Semester Student (Graduating Soon)'}
    </div>
    <p class="font-sans text-cream-300 text-sm max-w-lg">
      {lang === 'es' 
        ? 'Actualmente cursando el último requisito para recibir el título profesional, tras haber completado las prácticas en Waygroup.'
        : 'Currently completing the final requirement to receive my professional degree, having completed my internship at Waygroup.'}
    </p>
  </div>
</section>
