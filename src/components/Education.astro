---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 px-6 md:px-12 max-w-[1440px] mx-auto border-b border-olive-700">
  
  <!-- Top Architectural Section Bar -->
  <div class="flex items-center justify-between border-b border-olive-700 pb-4 mb-12 font-mono text-xs uppercase tracking-[0.2em] text-moss-500 scroll-reveal reveal-up">
    <div class="flex items-center gap-3">
      <span class="text-accent-400 font-bold">03 //</span>
      <span class="text-cream-100">{t('education.label')}</span>
    </div>
    <span>ACADEMIC_RECORD // B.ENG</span>
  </div>
  
  <div class="corner-brackets bg-forest-900 border border-olive-700 p-8 md:p-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center scroll-reveal reveal-up" data-delay="100">
    <div class="lg:col-span-7">
      <div class="font-mono text-xs text-accent-400 uppercase tracking-[0.25em] mb-3 flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-accent-400"></span>
        <span>{lang === 'es' ? 'ÚLTIMO SEMESTRE · PRÓXIMO A GRADUARSE' : 'FINAL SEMESTER · GRADUATING SOON'}</span>
      </div>
      <h3 class="font-display text-3xl sm:text-4xl md:text-5xl text-cream-100 font-extrabold uppercase tracking-tighter leading-none">
        {lang === 'es' ? 'Ingeniería en Diseño de Entretenimiento Digital' : 'Digital Entertainment Design Engineering'}
      </h3>
    </div>

    <div class="lg:col-span-5 lg:border-l lg:border-olive-700 lg:pl-8">
      <p class="font-sans text-cream-300 text-base leading-relaxed">
        {lang === 'es' 
          ? 'Especialización en desarrollo de videojuegos y sistemas interactivos. Actualmente cursando el último requisito para recibir el título profesional tras completar la práctica en Waygroup.'
          : 'Specialized in video game development and interactive systems. Currently completing the final requirement to receive my professional engineering degree after completing my industry internship at Waygroup.'}
      </p>
    </div>
  </div>
</section>
