---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experiences = [
  {
    role: lang === 'es' ? 'Desarrollador Junior' : 'Junior Developer',
    company: 'Waygroup',
    date: lang === 'es' ? 'Junio 2024 — Presente' : 'June 2024 — Present',
    description: lang === 'es' 
      ? 'Desarrollo de experiencias interactivas, herramientas XR y mantenimiento de proyectos.' 
      : 'Development of interactive experiences, XR tools, and project maintenance.'
  },
  {
    role: lang === 'es' ? 'Practicante de Desarrollo' : 'Development Intern',
    company: 'Waygroup',
    date: lang === 'es' ? 'Enero 2024 — Junio 2024' : 'January 2024 — June 2024',
    description: lang === 'es'
      ? 'Apoyo en el desarrollo de simuladores y aplicaciones de realidad virtual/aumentada.'
      : 'Support in the development of simulators and virtual/augmented reality applications.'
  },
  {
    role: lang === 'es' ? 'Desarrollador Freelance' : 'Freelance Developer',
    company: 'Independiente / Freelance',
    date: '2022 — 2024',
    description: lang === 'es'
      ? 'Creación de prototipos, juegos y aplicaciones.'
      : 'Creation of prototypes, games, and applications.'
  }
];
---

<section id="experience" class="py-24 px-6 md:px-12 max-w-3xl mx-auto border-t border-olive-700/30 mt-24">
  <div class="mb-16">
    <h2 class="font-mono text-moss-500 uppercase tracking-widest text-sm mb-4">{t('experience.label')}</h2>
    <h3 class="font-display text-4xl text-cream-100">{t('experience.title')}</h3>
  </div>

  <div class="space-y-16 relative before:absolute before:inset-0 before:ml-2 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-olive-700 before:via-olive-700/50 before:to-transparent">
    {experiences.map((exp, i) => (
      <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
        {/* Timeline dot */}
        <div class="flex items-center justify-center w-5 h-5 rounded-full border-2 border-accent-400 bg-forest-950 absolute left-0 md:left-1/2 md:-translate-x-1/2 shadow shadow-accent-400/20"></div>
        
        {/* Card */}
        <div class="ml-10 md:ml-0 md:w-[calc(50%-2rem)] md:group-even:text-right">
          <div class="font-mono text-moss-500 text-sm mb-2">{exp.date}</div>
          <h4 class="font-display text-2xl text-cream-100 mb-1">{exp.role}</h4>
          <div class="font-sans text-cream-300 font-medium mb-4">{exp.company}</div>
          <p class="font-sans text-cream-300/80 text-base leading-relaxed">
            {exp.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
