---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experiences = [
  {
    index: '01',
    role: lang === 'es' ? 'Desarrollador Junior' : 'Junior Developer',
    company: 'Waygroup',
    date: lang === 'es' ? 'JULIO 2026 — PRESENTE' : 'JULY 2026 — PRESENT',
    tag: 'UNITY / XR / PRODUCTION',
    description: lang === 'es' 
      ? 'Desarrollo de experiencias interactivas, herramientas XR y mantenimiento de proyectos en producción.' 
      : 'Development of interactive experiences, XR tools, and production project maintenance.'
  },
  {
    index: '02',
    role: lang === 'es' ? 'Practicante de Desarrollo' : 'Development Intern',
    company: 'Waygroup',
    date: lang === 'es' ? 'ENERO 2026 — JULIO 2026' : 'JANUARY 2026 — JULY 2026',
    tag: 'VR / SIMULATORS / R&D',
    description: lang === 'es'
      ? 'Apoyo en el desarrollo de simuladores y aplicaciones de realidad virtual y aumentada.'
      : 'Support in the development of simulators and virtual/augmented reality applications.'
  },
  {
    index: '03',
    role: lang === 'es' ? 'Desarrollador Independiente — AI Quest' : 'Independent Developer — AI Quest',
    company: 'UPB (Universidad Pontificia Bolivariana)',
    date: lang === 'es' ? 'JUNIO 2025 — ACTUAL' : 'JUNE 2025 — PRESENT',
    tag: 'GAME SYSTEMS / AI QUEST / EN DESARROLLO',
    description: lang === 'es'
      ? 'Desarrollo como independiente en el proyecto "AI Quest" junto a la UPB, enfocado en mecánicas interactivas y arquitectura del juego (en desarrollo activo).'
      : 'Independent development on the "AI Quest" project in partnership with UPB, focused on interactive gameplay mechanics and architecture (currently in active development).'
  },
  {
    index: '04',
    role: lang === 'es' ? 'Desarrollador Freelance' : 'Freelance Developer',
    company: lang === 'es' ? 'Independiente' : 'Independent',
    date: lang === 'es' ? '2024 — PRESENTE' : '2024 — PRESENT',
    tag: 'GAME SYSTEMS / PROTOTYPING / C#',
    description: lang === 'es'
      ? 'Creación de prototipos jugables, mecánicas de juego, sistemas interactivos y aplicaciones a medida.'
      : 'Creation of playable prototypes, gameplay systems, interactive mechanics, and custom applications.'
  }
];
---

<section id="experience" class="py-28 md:py-36 px-6 md:px-12 max-w-[1440px] mx-auto border-b border-olive-700">
  
  <!-- Top Architectural Section Bar -->
  <div class="flex items-center justify-between border-b border-olive-700 pb-4 mb-12 font-mono text-xs uppercase tracking-[0.2em] text-moss-500 scroll-reveal reveal-up">
    <div class="flex items-center gap-3">
      <span class="text-accent-400 font-bold">02 //</span>
      <span class="text-cream-100">{t('experience.label')}</span>
    </div>
    <span>CAREER_LOG // CHRONOLOGICAL</span>
  </div>

  <!-- Editorial Section Headline -->
  <div class="mb-16 scroll-reveal reveal-up">
    <h3 class="font-display text-5xl sm:text-6xl md:text-7xl text-cream-100 font-extrabold uppercase tracking-tighter leading-[0.9]">
      {t('experience.title')}<span class="text-accent-400">.</span>
    </h3>
  </div>

  <!-- Brutalist Ledger Rows (Replaces generic AI vertical circle timeline) -->
  <div class="border-t border-olive-700">
    {experiences.map((exp, i) => (
      <div 
        class="group grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8 py-10 px-4 md:px-6 border-b border-olive-700 hover:bg-forest-900/90 transition-colors items-start scroll-reveal reveal-up" 
        data-delay={i * 100}
      >
        {/* Col 1: Index & Date */}
        <div class="lg:col-span-3 flex items-center lg:flex-col lg:items-start justify-between gap-2 font-mono">
          <span class="text-xs text-accent-400 font-bold tracking-widest">[{exp.index}]</span>
          <span class="text-xs text-moss-500 uppercase tracking-wider">{exp.date}</span>
        </div>

        {/* Col 2: Role & Company */}
        <div class="lg:col-span-4">
          <h4 class="font-display text-2xl sm:text-3xl text-cream-100 font-bold uppercase tracking-tight group-hover:text-accent-400 transition-colors">
            {exp.role}
          </h4>
          <div class="font-mono text-xs uppercase tracking-[0.2em] text-cream-300 mt-1">
            @ {exp.company}
          </div>
        </div>

        {/* Col 3: Description & Tech Tag */}
        <div class="lg:col-span-5 flex flex-col justify-between gap-4">
          <p class="font-sans text-cream-300 text-base leading-relaxed">
            {exp.description}
          </p>
          <div>
            <span class="inline-block font-mono text-[10px] uppercase tracking-[0.2em] text-moss-500 border border-olive-700 px-2.5 py-1 bg-forest-950">
              {exp.tag}
            </span>
          </div>
        </div>
      </div>
    ))}
  </div>

</section>
