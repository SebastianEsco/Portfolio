---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const year = new Date().getFullYear();
---

<footer class="border-t border-olive-700 bg-forest-950 text-cream-300 font-mono text-xs uppercase tracking-[0.2em]">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-10 flex flex-col sm:flex-row justify-between items-center gap-6">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 bg-accent-400 inline-block"></span>
      <span class="text-cream-100 font-bold">&copy; {year} SEBASTIÁN ESCOBAR.</span>
    </div>
    
    <div class="flex items-center gap-8">
      <a href="https://www.linkedin.com/in/sebasti%C3%A1n-escobar-mej%C3%ADa-133b332a0/" target="_blank" rel="noopener noreferrer" class="hover:text-accent-400 transition-colors flex items-center gap-1.5">
        <span>LINKEDIN</span>
        <span class="text-accent-400">↗</span>
      </a>
      <a href="https://github.com/SebastianEsco" target="_blank" rel="noopener noreferrer" class="hover:text-accent-400 transition-colors flex items-center gap-1.5">
        <span>GITHUB</span>
        <span class="text-accent-400">↗</span>
      </a>
    </div>
  </div>
</footer>
