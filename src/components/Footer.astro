---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { homeUrl } from '../i18n/paths';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="py-12 px-6 md:px-12 mt-20 border-t border-olive-700/30 text-cream-300 font-sans text-sm flex flex-col md:flex-row justify-between items-center gap-4">
  <div>
    &copy; {year} Sebastián Escobar.
  </div>
  
  <div class="flex gap-6 uppercase tracking-widest text-xs">
    <a href="https://linkedin.com/in/sebastian-escobar-mejía" target="_blank" rel="noopener noreferrer" class="hover:text-accent-400 transition-colors">LinkedIn</a>
    <a href="https://github.com/SebastianEsco" target="_blank" rel="noopener noreferrer" class="hover:text-accent-400 transition-colors">GitHub</a>
  </div>
</footer>
