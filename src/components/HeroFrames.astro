---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 60 frames in public/frames/
const frameCount = 60;
const frames = Array.from({ length: frameCount }, (_, i) => {
  const num = String(i + 1).padStart(4, '0');
  return `/Portfolio/frames/${num}.jpg`;
});
---

<section id="hero" class="relative h-[200vh] bg-forest-950 border-b border-olive-700">
  <div id="hero-sticky" class="sticky top-0 h-screen w-full overflow-hidden flex flex-col justify-between p-6 md:p-12 pt-24">
    
    <!-- Canvas for sequence -->
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full object-cover opacity-75 will-change-transform"></canvas>
    
    <!-- Architectural Vignette & Contrast Gradient -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_20%,rgba(10,11,10,0.85)_100%)] pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-transparent to-forest-950/60 pointer-events-none"></div>

    <!-- Viewport Corner Crosshairs -->
    <div class="relative z-20 flex justify-between items-start pointer-events-none font-mono text-[10px] tracking-[0.22em] text-cream-300/80 uppercase">
      <div class="flex flex-col gap-1 border-l-2 border-accent-400 pl-3">
        <span class="text-accent-400 font-bold">CAM_01 // ISOMETRIC_VIEWPORT</span>
        <span>UNITY_ENGINE · UNREAL_5 · META_XR</span>
      </div>
      <div class="hidden sm:flex flex-col items-end gap-1 border-r-2 border-olive-700 pr-3">
        <span>STATUS: <strong class="text-cream-100">ONLINE</strong></span>
        <span>LOC: MEDELLÍN, COLOMBIA</span>
      </div>
    </div>

    <!-- Center / Editorial Asymmetric Hero Lockup -->
    <div id="hero-title-box" class="relative z-10 my-auto max-w-[1440px] w-full mx-auto will-change-transform transition-transform duration-300 ease-out">
      <div class="inline-flex items-center gap-3 bg-forest-950/90 border border-olive-700 px-3.5 py-1.5 mb-5">
        <span class="w-2 h-2 bg-accent-400"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-cream-100 font-semibold">
          {t('hero.role')} // {t('hero.location')}
        </span>
      </div>

      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-[7.2rem] text-cream-100 font-extrabold uppercase tracking-tighter leading-[0.88] drop-shadow-2xl">
        SEBASTIÁN<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cream-100 via-cream-100 to-moss-500">ESCOBAR</span><span class="text-accent-400">.</span>
      </h1>
    </div>

    <!-- Bottom HUD Bar: Scroll Indicator + Frame Scrubbing Telemetry -->
    <div class="relative z-20 flex justify-between items-end border-t border-olive-700/80 pt-4 font-mono text-[11px] uppercase tracking-[0.2em]">
      <!-- Scroll Indicator -->
      <div id="hero-scroll-indicator" class="flex items-center gap-3 text-cream-100 transition-all duration-300 pointer-events-none">
        <span class="inline-block w-1.5 h-4 bg-accent-400 animate-bounce"></span>
        <span>[ {t('hero.scroll')} TO SCRUB TIMELINE ]</span>
      </div>

      <!-- Frame Telemetry Counter -->
      <div id="hero-hud" class="flex items-center gap-4 bg-forest-950/90 border border-olive-700 px-4 py-2 pointer-events-none">
        <span class="text-moss-500 hidden sm:inline">TIMELINE_BUFFER</span>
        <div class="w-20 h-1.5 bg-olive-700 overflow-hidden hidden md:block">
          <div id="hud-progress-bar" class="h-full bg-accent-400 w-[2%]"></div>
        </div>
        <div class="flex items-center gap-1">
          <span class="text-moss-500">FRM</span>
          <span id="hud-frame" class="text-accent-400 font-bold text-xs">01</span>
          <span class="text-moss-500">/60</span>
        </div>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ frames, frameCount }}>
  function initHeroFrames() {
    const canvas = document.getElementById('hero-canvas');
    const scrollIndicator = document.getElementById('hero-scroll-indicator');
    const hudFrame = document.getElementById('hud-frame');
    const hudProgressBar = document.getElementById('hud-progress-bar');
    const heroTitle = document.getElementById('hero-title-box');
    const heroSticky = document.getElementById('hero-sticky');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    
    let width, height;
    const loadedImages = new Array(frameCount);
    
    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
      render(Math.floor(currentFrameIndex));
    }
    window.addEventListener('resize', resize);
    
    // Preload
    frames.forEach((src, idx) => {
      const img = new Image();
      img.src = src;
      img.onload = () => {
        loadedImages[idx] = img;
        if (idx === 0) {
          render(0);
        }
      };
    });

    // Render frame
    function render(index) {
      if (!ctx) return;
      const safeIndex = Math.max(0, Math.min(frameCount - 1, index));
      const img = loadedImages[safeIndex];
      if (!img) return;
      
      ctx.clearRect(0, 0, width, height);
      
      const imgRatio = img.width / img.height;
      const canvasRatio = width / height;
      
      let drawWidth, drawHeight, offsetX, offsetY;
      
      if (canvasRatio > imgRatio) {
        drawWidth = width;
        drawHeight = width / imgRatio;
        offsetX = 0;
        offsetY = (height - drawHeight) / 2;
      } else {
        drawWidth = height * imgRatio;
        drawHeight = height;
        offsetX = (width - drawWidth) / 2;
        offsetY = 0;
      }
      
      ctx.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
    }

    // Subtle 3D Perspective Tilt on Mouse Movement
    if (heroSticky) {
      heroSticky.addEventListener('mousemove', (e) => {
        const rect = heroSticky.getBoundingClientRect();
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const tiltX = ((e.clientY - centerY) / centerY) * -2.5;
        const tiltY = ((e.clientX - centerX) / centerX) * 2.5;

        if (heroTitle) {
          heroTitle.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
        }
      });

      heroSticky.addEventListener('mouseleave', () => {
        if (heroTitle) {
          heroTitle.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
        }
      });
    }

    // Scroll logic
    let currentFrameIndex = 0;
    const section = document.getElementById('hero');
    
    function onScroll() {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const scrollProgress = -rect.top / window.innerHeight;
      const progress = Math.max(0, Math.min(1, scrollProgress));
      
      // 1. Smoothly fade out scroll indicator as soon as user starts scrolling
      if (scrollIndicator) {
        const opacity = Math.max(0, 1 - progress * 6);
        scrollIndicator.style.opacity = opacity.toString();
        scrollIndicator.style.transform = `translateY(${progress * 20}px)`;
      }

      // 2. Update current frame index and canvas
      currentFrameIndex = progress * (frameCount - 1);
      const frameNum = Math.floor(currentFrameIndex);
      render(frameNum);

      // 3. Live telemetry HUD update
      if (hudFrame) {
        hudFrame.textContent = String(frameNum + 1).padStart(2, '0');
      }
      if (hudProgressBar) {
        hudProgressBar.style.width = `${Math.max(2, ((frameNum + 1) / frameCount) * 100)}%`;
      }
    }

    window.addEventListener('scroll', () => {
      requestAnimationFrame(onScroll);
    }, { passive: true });
    
    resize();
    onScroll();
  }

  document.addEventListener('astro:page-load', initHeroFrames);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeroFrames();
  } else {
    document.addEventListener('DOMContentLoaded', initHeroFrames);
  }
</script>
