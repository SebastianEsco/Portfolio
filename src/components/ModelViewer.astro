---
interface Props {
  modelPath: string;
  caption?: string;
  hint?: string;
}

const { modelPath, caption, hint = "Drag to rotate · Scroll to zoom" } = Astro.props;
---

<div class="my-16">
  <div class="relative w-full h-[450px] md:h-[550px] bg-forest-900 rounded-2xl border border-olive-700/60 overflow-hidden shadow-2xl flex items-center justify-center">
    <!-- Google model-viewer web component -->
    <model-viewer
      src={modelPath}
      alt="3D Model Viewer"
      auto-rotate
      camera-controls
      touch-action="pan-y"
      shadow-intensity="1.5"
      exposure="1"
      class="w-full h-full bg-transparent"
    >
      <div slot="poster" class="w-full h-full flex items-center justify-center text-moss-500 font-mono text-sm animate-pulse">
        Loading 3D Model...
      </div>
    </model-viewer>

    <!-- Floating user hint badge -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-forest-950/80 border border-olive-700/60 backdrop-blur-md text-xs font-mono text-cream-300 pointer-events-none tracking-wider shadow-lg">
      ✦ {hint}
    </div>
  </div>

  {caption && (
    <p class="text-center font-mono text-xs text-moss-500 mt-3 tracking-wide">
      {caption}
    </p>
  )}
</div>

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
