---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<div 
  id="page-intro-loader" 
  class="fixed inset-0 z-[9999] bg-forest-950 flex flex-col justify-between p-6 md:p-12 select-none overflow-hidden opacity-0 transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] border-b-2 border-accent-400"
  aria-hidden="true"
>
  <!-- Top Technical Bar -->
  <div class="flex justify-between items-center font-mono text-[10px] tracking-[0.2em] text-moss-500 uppercase border-b border-olive-700 pb-4">
    <span>SYS.BOOT // SEBASTIAN_ESCOBAR_PORTFOLIO</span>
    <span>BUILD v2.6 // MEDELLÍN, CO</span>
  </div>

  <!-- Center Editorial Lockup -->
  <div id="loader-content" class="relative z-10 my-auto max-w-5xl transition-all duration-400 ease-out opacity-0 translate-y-4">
    <div class="font-mono text-xs text-accent-400 uppercase tracking-[0.3em] mb-3 flex items-center gap-3">
      <span class="inline-block w-2 h-2 bg-accent-400"></span>
      <span>{lang === 'es' ? 'INGENIERÍA INTERACTIVA · VIDEOJUEGOS & XR' : 'INTERACTIVE ENGINEERING · GAME & XR DEV'}</span>
    </div>

    <h1 class="font-display text-4xl sm:text-7xl md:text-8xl font-extrabold uppercase tracking-tighter text-cream-100 leading-[0.9]">
      SEBASTIÁN<br/>ESCOBAR
    </h1>
  </div>

  <!-- Bottom Telemetry Progress Bar -->
  <div class="w-full">
    <div class="flex justify-between items-baseline font-mono text-[11px] uppercase tracking-widest text-cream-300 mb-2">
      <span>INITIALIZING VIEWPORT PIPELINE...</span>
      <span class="text-accent-400 font-bold">100%</span>
    </div>
    <div class="w-full h-[3px] bg-olive-700 overflow-hidden relative">
      <div id="loader-progress-bar" class="absolute inset-y-0 left-0 w-0 bg-accent-400 transition-all duration-400 ease-out"></div>
    </div>
  </div>
</div>

<style>
  #page-intro-loader.active {
    opacity: 1;
  }

  #page-intro-loader.active #loader-content {
    opacity: 1;
    transform: translateY(0);
  }

  #page-intro-loader.dismissed {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
  }

  #page-intro-loader.dismissed #loader-content {
    opacity: 0;
    transform: translateY(-25px);
  }
</style>

<script>
  function dismissLoader() {
    const loader = document.getElementById('page-intro-loader');
    const bar = document.getElementById('loader-progress-bar');
    if (!loader) return;

    // Smooth fade in on screen
    requestAnimationFrame(() => {
      loader.classList.add('active');
    });

    // Instantly charge progress bar
    setTimeout(() => {
      if (bar) bar.style.width = '100%';
    }, 40);

    // Fast, crisp dismissal (around 450ms)
    setTimeout(() => {
      loader.classList.add('dismissed');
      document.body.style.overflow = '';

      setTimeout(() => {
        loader.style.display = 'none';
      }, 550);
    }, 450);

    // Safety fallback: guarantee body scroll is restored and loader hidden
    setTimeout(() => {
      document.body.style.overflow = '';
      if (loader) loader.style.display = 'none';
    }, 1000);
  }

  // Trigger on initial page load AND on every Astro ClientRouter transition
  document.addEventListener('astro:page-load', dismissLoader);
  document.addEventListener('astro:after-swap', dismissLoader);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    dismissLoader();
  } else {
    document.addEventListener('DOMContentLoaded', dismissLoader);
  }
</script>
