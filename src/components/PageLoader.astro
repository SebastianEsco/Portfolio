---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<div 
  id="page-intro-loader" 
  class="fixed inset-0 z-[9999] bg-forest-950 flex flex-col items-center justify-center select-none overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]"
  aria-hidden="true"
>
  <!-- Background warm ambient glow -->
  <div class="absolute w-[500px] h-[500px] rounded-full bg-accent-400/10 blur-[100px] pointer-events-none"></div>

  <!-- Loader Content -->
  <div id="loader-content" class="relative z-10 text-center px-6 transition-all duration-400 ease-out">
    <div class="overflow-hidden mb-2">
      <span class="inline-block font-mono text-[11px] sm:text-xs text-moss-500 uppercase tracking-[0.25em]">
        {lang === 'es' ? 'DESARROLLADOR DE VIDEOJUEGOS & XR' : 'GAME & XR DEVELOPER'}
      </span>
    </div>

    <div class="overflow-hidden py-1">
      <h1 class="font-display text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-cream-100">
        Sebastián Escobar
      </h1>
    </div>

    <!-- Expanding terracotta accent line -->
    <div class="w-36 sm:w-52 h-[2px] bg-olive-700/50 mx-auto mt-4 rounded-full overflow-hidden relative">
      <div id="loader-progress-bar" class="absolute inset-y-0 left-0 w-0 bg-accent-400 rounded-full transition-all duration-400 ease-out"></div>
    </div>
  </div>
</div>

<style>
  #page-intro-loader.dismissed {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
  }

  #page-intro-loader.dismissed #loader-content {
    opacity: 0;
    transform: translateY(-25px);
  }
</style>

<script>
  function dismissLoader() {
    const loader = document.getElementById('page-intro-loader');
    const bar = document.getElementById('loader-progress-bar');
    if (!loader) return;

    // Instantly charge progress bar
    if (bar) bar.style.width = '100%';

    // Fast, crisp dismissal (max 450ms)
    setTimeout(() => {
      loader.classList.add('dismissed');
      document.body.style.overflow = '';

      setTimeout(() => {
        loader.style.display = 'none';
      }, 550);
    }, 450);

    // Safety fallback: guarantee body scroll is restored and loader hidden
    setTimeout(() => {
      document.body.style.overflow = '';
      if (loader) loader.style.display = 'none';
    }, 1000);
  }

  // Trigger on initial page load AND on every Astro ClientRouter transition
  document.addEventListener('astro:page-load', dismissLoader);
  document.addEventListener('astro:after-swap', dismissLoader);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    dismissLoader();
  } else {
    document.addEventListener('DOMContentLoaded', dismissLoader);
  }
</script>
