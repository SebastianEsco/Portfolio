---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillGroups = [
  {
    code: 'MOD_01',
    name: t('skills.engines'),
    items: ['Unity Engine', 'Unreal Engine 5']
  },
  {
    code: 'MOD_02',
    name: t('skills.languages'),
    items: ['C#', 'Blueprints', 'Python']
  },
  {
    code: 'MOD_03',
    name: t('skills.xr'),
    items: ['Meta SDK (Unity / Unreal)', 'Vuforia']
  },
  {
    code: 'MOD_04',
    name: t('skills.tools'),
    items: [
      'Reaper',
      'Blender',
      'Git',
      'Figma',
      lang === 'es' ? 'Edición de Fotos' : 'Photo Editing'
    ]
  }
];
---

<section class="py-28 md:py-36 px-6 md:px-12 max-w-[1440px] mx-auto border-b border-olive-700">
  
  <!-- Top Architectural Section Bar -->
  <div class="flex items-center justify-between border-b border-olive-700 pb-4 mb-12 font-mono text-xs uppercase tracking-[0.2em] text-moss-500 scroll-reveal reveal-up">
    <div class="flex items-center gap-3">
      <span class="text-accent-400 font-bold">04 //</span>
      <span class="text-cream-100">{t('skills.label')}</span>
    </div>
    <span>TECH_STACK // CAPABILITIES</span>
  </div>

  <!-- Brutalist Modular Matrix -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-olive-700">
    {skillGroups.map((group, index) => (
      <div class="border-r border-b border-olive-700 bg-forest-950 hover:bg-forest-900/80 transition-colors p-6 md:p-8 flex flex-col justify-between scroll-reveal reveal-up" data-delay={index * 80}>
        <div>
          <div class="flex items-center justify-between font-mono text-[10px] tracking-[0.2em] text-moss-500 uppercase mb-6 pb-3 border-b border-olive-700">
            <span>{group.code}</span>
            <span class="text-accent-400">● READY</span>
          </div>
          
          <h3 class="font-display text-2xl sm:text-3xl text-cream-100 font-extrabold uppercase tracking-tight mb-8">
            {group.name}
          </h3>
        </div>

        <ul class="space-y-2.5">
          {group.items.map((item, idx) => (
            <li class="flex items-center justify-between px-3.5 py-2.5 bg-forest-900 border border-olive-700 hover:border-accent-400 transition-colors font-mono text-xs text-cream-100">
              <span>{item}</span>
              <span class="text-[10px] text-moss-500">0{idx + 1}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

</section>
