---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillGroups = [
  {
    name: t('skills.engines'),
    items: ['Unity Engine', 'Unreal Engine 5']
  },
  {
    name: t('skills.languages'),
    items: ['C#', 'Blueprints', 'Python']
  },
  {
    name: t('skills.xr'),
    items: ['Meta SDK (Unity / Unreal)', 'Vuforia']
  },
  {
    name: t('skills.tools'),
    items: [
      'Reaper',
      'Blender',
      'Git',
      'Figma',
      lang === 'es' ? 'Edición de Fotos' : 'Photo Editing'
    ]
  }
];
---

<section class="py-24 px-6 md:px-12 max-w-7xl mx-auto">
  <div class="mb-12 text-center md:text-left scroll-reveal reveal-up">
    <h2 class="font-mono text-moss-500 uppercase tracking-widest text-sm mb-4">{t('skills.label')}</h2>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
    {skillGroups.map((group, index) => (
      <div class="scroll-reveal reveal-up" data-delay={index * 100}>
        <h3 class="font-display text-xl text-cream-100 mb-6 border-b border-olive-700 pb-4">{group.name}</h3>
        <ul class="space-y-3 font-sans text-cream-300">
          {group.items.map(item => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-moss-500"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
