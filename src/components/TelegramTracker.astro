---
// Telegram Visitor Tracker (Privacy-first & Zero Cookies)
---

<script>
  // Obfuscated credentials
  const _k = 'ODc5MzIxMDM1ODpBQUhmMEJmZEhKcjRBYjdVY3JCSmd4c1FWelhaU29GbTVLNA==';
  const _c = 'MTgxMzgwMjk5MQ==';

  function decodeKey(s: string): string {
    try {
      return atob(s);
    } catch {
      return '';
    }
  }

  // Location cache to avoid redundant calls during the same session
  let cachedLocation: string | null = null;

  async function getLocation(): Promise<string> {
    if (cachedLocation) return cachedLocation;
    
    // Check sessionStorage first
    try {
      const stored = sessionStorage.getItem('visitor_loc');
      if (stored) {
        cachedLocation = stored;
        return stored;
      }
    } catch {}

    // Use ipwho.is with timeout fallback
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 2500);

      const res = await fetch('https://ipwho.is/', {
        signal: controller.signal,
        cache: 'force-cache'
      });
      clearTimeout(timeoutId);

      if (res.ok) {
        const data = await res.json();
        if (data && data.success !== false) {
          const city = data.city || '';
          const country = data.country || '';
          cachedLocation = city ? `${city}, ${country}` : (country || 'Desconocido');
          try {
            sessionStorage.setItem('visitor_loc', cachedLocation);
          } catch {}
          return cachedLocation;
        }
      }
    } catch {
      // Silently continue if blocked or timeout
    }

    cachedLocation = 'Ubicación no disponible';
    return cachedLocation;
  }

  async function sendTelegramNotification(text: string) {
    try {
      const token = decodeKey(_k);
      const chatId = decodeKey(_c);
      if (!token || !chatId) return;

      const url = `https://api.telegram.org/bot${token}/sendMessage`;
      await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          chat_id: chatId,
          text: text,
          parse_mode: 'HTML',
          disable_web_page_preview: true,
        }),
      });
    } catch {
      // Never disrupt user experience
    }
  }

  function getPageTitle(path: string): string {
    const cleanPath = path.toLowerCase();
    if (cleanPath.includes('echoes')) return 'Echoes of the Past (Proyecto)';
    if (cleanPath.includes('entre-balcones')) return 'Entre Balcones (Proyecto)';
    if (cleanPath.includes('kapsula-12')) return 'Kapsula 12 (Proyecto)';
    if (cleanPath.includes('nuclear-rush')) return 'Nuclear Rush (Proyecto)';
    if (cleanPath.endsWith('/en') || cleanPath.endsWith('/en/') || cleanPath.endsWith('/es') || cleanPath.endsWith('/es/') || cleanPath === '/' || cleanPath.endsWith('/portfolio/')) {
      return 'Inicio / Home';
    }
    return path;
  }

  let isTracking = false;

  async function trackPageView() {
    if (isTracking) return;
    isTracking = true;

    try {
      const currentPath = window.location.pathname;
      const lastPage = sessionStorage.getItem('last_visited_page');

      // Avoid duplicate triggers for the exact same page in rapid succession
      if (lastPage === currentPath) {
        isTracking = false;
        return;
      }
      sessionStorage.setItem('last_visited_page', currentPath);

      const isFirstVisit = !sessionStorage.getItem('visited_session_started');
      const pageName = getPageTitle(currentPath);

      // Format local time nicely
      const now = new Date().toLocaleTimeString('es-CO', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      });

      const location = await getLocation();

      let message = '';
      if (isFirstVisit) {
        sessionStorage.setItem('visited_session_started', 'true');
        const device = /Mobi|Android|iPhone/i.test(navigator.userAgent) ? 'Móvil' : 'PC / Laptop';
        const ref = document.referrer ? `\nOrigen: ${document.referrer}` : '';

        message = 
          `<b>[NUEVA VISITA]</b>\n` +
          `Ubicación: ${location}\n` +
          `Dispositivo: ${device}\n` +
          `Hora: ${now}\n` +
          `Página: <code>${pageName}</code>` +
          ref;
      } else {
        message = 
          `<b>[NAVEGACIÓN]</b>\n` +
          `Ubicación: ${location}\n` +
          `Hora: ${now}\n` +
          `Página: <code>${pageName}</code>`;
      }

      await sendTelegramNotification(message);
    } catch {
      // Safe fallback
    } finally {
      isTracking = false;
    }
  }

  // Trigger on initial page load AND on every Astro ClientRouter transition
  document.addEventListener('astro:page-load', trackPageView);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    trackPageView();
  } else {
    document.addEventListener('DOMContentLoaded', trackPageView);
  }
</script>
