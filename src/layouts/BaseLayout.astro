---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientLights from '../components/AmbientLights.astro';
import PageLoader from '../components/PageLoader.astro';
import TelegramTracker from '../components/TelegramTracker.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Portfolio of Sebastian Escobar - Game & XR Developer" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/Portfolio/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<ClientRouter />
		
		<!-- Google Fonts: Syne (Avant-Garde Display), Plus Jakarta Sans (Editorial Body), JetBrains Mono (Engine HUD) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..700;1,400&family=Plus+Jakarta+Sans:wght@300..700&family=Syne:wght@600..800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-forest-950 text-cream-100 min-h-screen flex flex-col relative">
		<TelegramTracker />
		<PageLoader />
		<AmbientLights />
		<Header />
		<main class="flex-grow relative z-10">
			<slot />
		</main>
		<Footer />

		<script>
			import Lenis from 'lenis';

			let lenis: Lenis | null = null;
			function initLenis() {
			  if (lenis) lenis.destroy();
			  lenis = new Lenis({
			    duration: 1.2,
			    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			    orientation: 'vertical',
			    gestureOrientation: 'vertical',
			    smoothWheel: true,
			    wheelMultiplier: 1,
			    smoothTouch: false,
			    touchMultiplier: 2,
			  });
			  function raf(time: number) {
			    lenis?.raf(time);
			    requestAnimationFrame(raf);
			  }
			  requestAnimationFrame(raf);
			}

			document.addEventListener('astro:page-load', initLenis);
			initLenis();

			// Scroll-driven bidirectional assembly observer
			function initScrollAssembly() {
			  const reveals = document.querySelectorAll<HTMLElement>('.scroll-reveal');
			  if (!reveals.length) return;

			  const observer = new IntersectionObserver(
			    (entries) => {
			      entries.forEach((entry) => {
			        const el = entry.target as HTMLElement;
			        const delay = parseInt(el.dataset.delay || '0', 10);

			        if (entry.isIntersecting) {
			          // Assembly entrance delay
			          setTimeout(() => {
			            el.classList.add('is-revealed');
			          }, delay);
			        } else {
			          // Disassembly exit when scrolling back up (while still in lower view area)
			          if (entry.boundingClientRect.top > 0) {
			            // Remove immediately when scrolling back up (no delay on exit)
			            el.classList.remove('is-revealed');
			          }
			        }
			      });
			    },
			    // -160px bottom margin means the trigger is well inside the visible screen!
			    { threshold: 0.12, rootMargin: '0px 0px -160px 0px' }
			  );

			  reveals.forEach((el) => observer.observe(el));
			}

			document.addEventListener('astro:page-load', initScrollAssembly);
			if (document.readyState === 'complete' || document.readyState === 'interactive') {
			  initScrollAssembly();
			}
		</script>
	</body>
</html>
