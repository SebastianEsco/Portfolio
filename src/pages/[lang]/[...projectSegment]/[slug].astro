---
import { getCollection, render } from 'astro:content';
import { langs, projectsSegment, fallbackLang } from '../../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { homeUrl } from '../../../i18n/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const paths = [];

  for (const lang of langs) {
    const langProjects = projects.filter(p => p.id.startsWith(`${lang}/`));
    for (const project of langProjects) {
      const slug = project.id.replace(`${lang}/`, '').replace('.md', '');
      paths.push({
        params: {
          lang,
          projectSegment: projectsSegment[lang],
          slug
        },
        props: { project }
      });
    }
  }

  return paths;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} · Sebastián Escobar`} description={project.data.title}>
  <article class="pt-32 pb-24 px-6 md:px-12 max-w-4xl mx-auto">
    
    <div class="mb-12">
      <a href={homeUrl(lang, '#work')} class="inline-flex items-center text-moss-500 font-sans text-sm hover:text-cream-100 transition-colors mb-8">
        <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t('project.back')}
      </a>
      
      <h1 class="font-display text-5xl md:text-7xl text-cream-100 mb-6">{project.data.title}</h1>
      
      <div class="flex flex-wrap gap-4 font-mono text-xs uppercase tracking-widest text-moss-500 mb-8 border-y border-olive-700/30 py-4">
        <span>{t('project.year')}: <strong class="text-cream-300 font-medium">{project.data.year}</strong></span>
        <span>{t('project.platform')}: <strong class="text-cream-300 font-medium">{project.data.platform}</strong></span>
        <span>{t('project.engine')}: <strong class="text-cream-300 font-medium">{project.data.engine}</strong></span>
        <span>{t('project.role')}: <strong class="text-cream-300 font-medium">{project.data.role}</strong></span>
      </div>
    </div>
    
    {project.data.youtubeId && (
      <div class="aspect-video w-full rounded-xl overflow-hidden bg-forest-900 border border-olive-700 mb-16 relative group">
         <iframe 
            class="w-full h-full" 
            src={`https://www.youtube.com/embed/${project.data.youtubeId}?autoplay=0&rel=0`} 
            title="YouTube video player" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
         </iframe>
      </div>
    )}

    <div class="prose prose-invert prose-p:text-cream-300 prose-headings:text-cream-100 prose-headings:font-display prose-a:text-brass-400 max-w-none prose-lg">
      <Content />
    </div>
  </article>
</BaseLayout>
