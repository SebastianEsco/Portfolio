---
import { getCollection, render } from 'astro:content';
import { langs, projectsSegment } from '../../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ModelViewer from '../../../components/ModelViewer.astro';
import { homeUrl, projectUrl } from '../../../i18n/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const paths = [];

  for (const lang of langs) {
    const langProjects = projects.filter(p => p.id.startsWith(`${lang}/`));
    const sortedProjects = [...langProjects].sort((a, b) => {
      const isEchoesA = a.id.includes('echoes');
      const isEchoesB = b.id.includes('echoes');
      if (isEchoesA && !isEchoesB) return -1;
      if (!isEchoesA && isEchoesB) return 1;
      return b.data.year - a.data.year;
    });

    sortedProjects.forEach((project, idx) => {
      const slug = project.id.replace(`${lang}/`, '').replace('.md', '');
      const nextProject = sortedProjects[(idx + 1) % sortedProjects.length];
      const nextSlug = nextProject.id.replace(`${lang}/`, '').replace('.md', '');
      paths.push({
        params: {
          lang,
          projectSegment: projectsSegment[lang],
          slug
        },
        props: { project, nextProject, nextSlug }
      });
    });
  }

  return paths;
}

const { project, nextProject, nextSlug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} · Sebastián Escobar`} description={project.data.title}>
  <article class="pt-28 pb-28 px-6 md:px-12 max-w-[1360px] mx-auto">
    
    <!-- Top Architectural Breadcrumb Bar -->
    <div class="flex items-center justify-between border-b border-olive-700 pb-4 mb-12 font-mono text-xs uppercase tracking-[0.2em] scroll-reveal reveal-up">
      <a href={homeUrl(lang, '#work')} class="inline-flex items-center text-cream-100 hover:text-accent-400 transition-colors group">
        <span class="text-accent-400 mr-2 group-hover:-translate-x-1 transition-transform">←</span>
        <span>[{t('project.back')}]</span>
      </a>
      <span class="text-moss-500">CASE_STUDY // {project.data.year}</span>
    </div>

    <!-- Editorial Project Header -->
    <div class="mb-14 scroll-reveal reveal-up">
      {project.data.award && (
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-accent-400 text-forest-950 font-mono text-[11px] font-bold uppercase tracking-[0.2em] mb-6">
          <span>★ {project.data.award}</span>
        </div>
      )}

      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl text-cream-100 font-extrabold uppercase tracking-tighter leading-[0.88] mb-12">
        {project.data.title}<span class="text-accent-400">.</span>
      </h1>
      
      <!-- Exposed Hairline Spec Sheet Table -->
      <div class="grid grid-cols-2 md:grid-cols-4 border border-olive-700 bg-forest-900/70 divide-y md:divide-y-0 divide-x divide-olive-700 font-mono">
        <div class="p-5">
          <span class="text-moss-500 text-[10px] uppercase tracking-[0.2em] block mb-1.5">// {t('project.year')}</span>
          <strong class="text-cream-100 font-bold text-sm uppercase tracking-wider">{project.data.year}</strong>
        </div>
        <div class="p-5">
          <span class="text-moss-500 text-[10px] uppercase tracking-[0.2em] block mb-1.5">// {t('project.platform')}</span>
          <strong class="text-cream-100 font-bold text-sm uppercase tracking-wider">{project.data.platform}</strong>
        </div>
        <div class="p-5">
          <span class="text-moss-500 text-[10px] uppercase tracking-[0.2em] block mb-1.5">// {t('project.engine')}</span>
          <strong class="text-cream-100 font-bold text-sm uppercase tracking-wider">{project.data.engine}</strong>
        </div>
        <div class="p-5">
          <span class="text-moss-500 text-[10px] uppercase tracking-[0.2em] block mb-1.5">// {t('project.role')}</span>
          <strong class="text-accent-400 font-bold text-sm uppercase tracking-wider">{project.data.role}</strong>
        </div>
      </div>
    </div>
    
    <!-- Wide Cinema Viewport for YouTube Trailer -->
    {project.data.youtubeId && (
      <div class="corner-brackets w-full bg-forest-900 border border-olive-700 mb-20 shadow-2xl relative scroll-reveal reveal-up" data-delay="100">
        <div class="flex items-center justify-between px-4 py-2 bg-forest-950 border-b border-olive-700 font-mono text-[10px] uppercase tracking-[0.2em] text-moss-500">
          <span>VIDEO_STREAM // TRAILER_CAPTURE</span>
          <span class="text-accent-400">1080P_60FPS</span>
        </div>
        <div class="aspect-video w-full">
          <iframe 
            class="w-full h-full" 
            src={`https://www.youtube.com/embed/${project.data.youtubeId}?autoplay=0&rel=0`} 
            title="Project Trailer" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
          </iframe>
        </div>
      </div>
    )}

    <!-- Asymmetric Editorial 2-Column Case Study Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-20 scroll-reveal reveal-up" data-delay="140">
      <div class="lg:col-span-4 font-mono text-xs uppercase tracking-[0.2em] text-moss-500 lg:sticky lg:top-28 h-fit border-l-2 border-accent-400 pl-4 space-y-2">
        <div class="text-cream-100 font-bold">TECHNICAL OVERVIEW</div>
        <div>ARCHITECTURE &amp; DESIGN</div>
        {project.data.duration && <div>DURATION: {project.data.duration}</div>}
        {project.data.teamSize && <div>TEAM: {project.data.teamSize}</div>}
      </div>

      <div class="lg:col-span-8 prose prose-invert prose-p:text-cream-300 prose-p:leading-relaxed prose-headings:text-cream-100 prose-headings:font-display prose-headings:uppercase prose-headings:tracking-tight prose-headings:font-extrabold prose-a:text-accent-400 prose-strong:text-cream-100 prose-hr:border-olive-700 max-w-none prose-lg">
        <Content />
      </div>
    </div>

    <!-- Interactive 3D Model Inspector -->
    {project.data.model3d && (
      <div class="scroll-reveal reveal-up" data-delay="100">
        <ModelViewer 
          modelPath={project.data.model3d.path} 
          caption={project.data.model3d.caption}
          hint={lang === 'es' ? 'ARRASTRA PARA ROTAR · RUEDA PARA ZOOM' : 'DRAG TO ROTATE · SCROLL TO ZOOM'}
        />
      </div>
    )}

    <!-- Brutalist Contact-Sheet Image Gallery -->
    {project.data.galleryImages && project.data.galleryImages.length > 0 && (
      <div class="mt-28 pt-12 border-t border-olive-700 scroll-reveal reveal-up">
        <div class="flex items-baseline justify-between mb-10">
          <h3 class="font-display text-4xl sm:text-5xl text-cream-100 font-extrabold uppercase tracking-tighter">
            {t('project.gallery')}<span class="text-accent-400">.</span>
          </h3>
          <span class="font-mono text-xs text-moss-500 uppercase tracking-[0.2em]">
            [{project.data.galleryImages.length} CAPTURES]
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6" id="gallery-grid">
          {project.data.galleryImages.map((img, index) => {
            // Make every 3rd image span wider for editorial rhythm
            const spanClass = index % 3 === 0 ? 'md:col-span-7' : index % 3 === 1 ? 'md:col-span-5' : 'md:col-span-12';
            const frameCode = `FIG_${String(index + 1).padStart(2, '0')}`;
            return (
              <button 
                type="button"
                class={`gallery-thumb corner-brackets ${spanClass} bg-forest-900 border border-olive-700 group relative aspect-[16/9] text-left cursor-pointer transition-all duration-300 hover:border-accent-400 focus:outline-none overflow-hidden scroll-reveal reveal-up`}
                data-img-src={img}
                data-img-index={index}
                data-delay={index * 60}
                aria-label={`View gallery image ${index + 1}`}
              >
                <div class="absolute top-0 left-0 z-20 px-3 py-1 bg-forest-950/90 border-b border-r border-olive-700 font-mono text-[10px] tracking-[0.2em] text-moss-500 group-hover:text-accent-400 transition-colors">
                  {frameCode}
                </div>
                <img 
                  src={img} 
                  alt={`${project.data.title} screenshot ${index + 1}`} 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 ease-out pointer-events-none" 
                  loading="lazy" 
                />
                <div class="absolute bottom-0 right-0 z-20 px-3 py-1.5 bg-forest-950/90 border-t border-l border-olive-700 text-accent-400 font-mono text-[10px] uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                  [EXPAND +]
                </div>
              </button>
            );
          })}
        </div>
      </div>
    )}

    <!-- Next Project Architectural Banner -->
    {nextProject && (
      <div class="mt-28 pt-12 border-t border-olive-700 scroll-reveal reveal-up">
        <div class="flex items-center justify-between mb-6 font-mono text-xs uppercase tracking-[0.2em] text-moss-500">
          <span>// {t('project.next')}</span>
          <a href={homeUrl(lang, '#work')} class="hover:text-accent-400 transition-colors">
            [{t('project.back')} ↑]
          </a>
        </div>
        <a 
          href={projectUrl(lang, nextSlug)} 
          class="corner-brackets group block p-8 md:p-12 bg-forest-900 border border-olive-700 hover:border-accent-400 transition-all duration-300 relative overflow-hidden"
        >
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 relative z-10">
            <div>
              <div class="flex items-center gap-3 mb-3 font-mono text-xs uppercase tracking-[0.2em] text-moss-500">
                <span class="text-accent-400 font-bold">[{nextProject.data.year}]</span>
                <span>//</span>
                <span>{nextProject.data.platform}</span>
              </div>
              <h4 class="text-4xl sm:text-6xl font-display text-cream-100 group-hover:text-accent-400 transition-colors font-extrabold uppercase tracking-tighter leading-none">
                {nextProject.data.title}
              </h4>
            </div>
            
            <div class="flex items-center gap-3 px-6 py-4 bg-forest-950 border border-olive-700 group-hover:bg-accent-400 group-hover:border-accent-400 group-hover:text-forest-950 text-cream-100 font-mono text-xs uppercase tracking-[0.2em] font-bold transition-all shrink-0">
              <span>{t('work.view')}</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      </div>
    )}

  </article>

  <!-- Industrial Lightbox Modal -->
  <div 
    id="lightbox-modal" 
    class="fixed inset-0 z-[100] bg-forest-950/95 backdrop-blur-xl hidden items-center justify-center p-4 sm:p-10 select-none" 
    role="dialog" 
    aria-modal="true"
    aria-label="Image Lightbox"
  >
    <div class="absolute top-6 left-6 right-6 flex items-center justify-between z-10 font-mono">
      <span id="lightbox-counter" class="text-xs text-accent-400 tracking-[0.2em] bg-forest-900 px-4 py-2 border border-olive-700">
        01 / 01
      </span>
      <button 
        id="lightbox-close" 
        class="px-4 py-2 text-xs uppercase tracking-[0.2em] text-cream-100 hover:bg-accent-400 hover:text-forest-950 bg-forest-900 border border-olive-700 transition-all cursor-pointer font-bold" 
        aria-label="Close image modal"
      >
        [ESC / CLOSE ✕]
      </button>
    </div>

    <button 
      id="lightbox-prev" 
      class="absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 p-4 text-cream-100 hover:bg-accent-400 hover:text-forest-950 bg-forest-900 border border-olive-700 transition-all cursor-pointer z-10 font-mono font-bold"
      aria-label="Previous image"
    >
      ←
    </button>

    <div class="relative max-w-6xl max-h-[85vh] w-full h-full flex items-center justify-center p-2">
      <img 
        id="lightbox-img" 
        src="" 
        alt="Enlarged view" 
        class="max-w-full max-h-[82vh] object-contain border border-olive-700 shadow-2xl" 
      />
    </div>

    <button 
      id="lightbox-next" 
      class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 p-4 text-cream-100 hover:bg-accent-400 hover:text-forest-950 bg-forest-900 border border-olive-700 transition-all cursor-pointer z-10 font-mono font-bold"
      aria-label="Next image"
    >
      →
    </button>
  </div>
</BaseLayout>

<script>
  function initLightbox() {
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const counter = document.getElementById('lightbox-counter');
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));

    if (!modal || !modalImg || thumbs.length === 0) return;

    let currentIndex = 0;
    const images = thumbs.map(btn => btn.getAttribute('data-img-src') || '');

    function showImage(idx: number) {
      if (idx < 0) idx = images.length - 1;
      if (idx >= images.length) idx = 0;
      currentIndex = idx;

      modalImg!.src = images[currentIndex];
      if (counter) {
        counter.textContent = `FIG_${String(currentIndex + 1).padStart(2, '0')} // ${String(images.length).padStart(2, '0')}`;
      }
    }

    function openModal(index: number) {
      showImage(index);
      modal!.classList.remove('hidden');
      modal!.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
      modalImg!.src = '';
      document.body.style.overflow = '';
    }

    thumbs.forEach((btn, idx) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(idx);
      });
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeModal();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(currentIndex + 1);
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal || (e.target as HTMLElement).tagName === 'DIV') {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === 'ArrowLeft') {
        showImage(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        showImage(currentIndex + 1);
      }
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initLightbox();
  } else {
    document.addEventListener('DOMContentLoaded', initLightbox);
  }
</script>
