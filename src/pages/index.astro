---
import { homeUrl } from '../i18n/paths';

const target = homeUrl('en');
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content={`0;url=${target}`}>
    <script define:vars={{ target }}>
      // Default landing language is English. Redirects to Spanish if browser is set to Spanish.
      var lang = navigator.language || navigator.userLanguage;
      var redirectLang = target;
      if (lang && lang.toLowerCase().startsWith('es')) {
        redirectLang = target.replace('/en/', '/es/');
      }
      window.location.replace(redirectLang);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={target}>portfolio...</a></p>
  </body>
</html>
