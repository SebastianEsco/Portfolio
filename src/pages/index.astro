---
import { homeUrl } from '../i18n/paths';

const target = homeUrl('es');
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content={`0;url=${target}`}>
    <script define:vars={{ target }}>
      // Try to read browser language before redirecting
      var lang = navigator.language || navigator.userLanguage;
      var redirectLang = target; // defaults to 'es' target path
      if (lang && lang.toLowerCase().startsWith('en')) {
        redirectLang = target.replace('/es/', '/en/');
      }
      window.location.replace(redirectLang);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={target}>portfolio...</a></p>
  </body>
</html>
